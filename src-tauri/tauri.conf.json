{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Editor",
  "version": "0.1.12",
  "identifier": "com.texteditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Text Editor",
        "width": 1100,
        "height": 720,
        "minWidth": 240,
        "minHeight": 240,
        "decorations": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "shortDescription": "A small frameless text editor",
    "longDescription": "Text Editor is a hyper-minimalist plain-text editor.",
    "category": "DeveloperTool",
    "resources": [
      "resources/app.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt"
        ],
        "name": "Text document",
        "description": "Plain text",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": [
          "md"
        ],
        "name": "Markdown document",
        "description": "Markdown text",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NkVEQzRGODlENDZDNzkKUldSNWJOU0pUOXh1RlMrMjdZY1lqTDh6a1djek1obkpBN0o3WExrTEFsaUZUbkdTSmJjR1J2V2oK",
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/matt-azar/text-editor@main/download-site/latest.json",
        "https://raw.githubusercontent.com/matt-azar/text-editor/main/download-site/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
